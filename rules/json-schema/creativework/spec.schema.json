{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agennext.dev/grammar/creativework/spec.schema.json",
  "title": "AGenNext Spec Grammar",
  "allOf": [
    { "$ref": "./base.schema.json" },
    {
      "type": "object",
      "required": ["description", "text"],
      "properties": {
        "@type": { "enum": ["TechArticle", "DigitalDocument"] },
        "artifactKind": { "const": "spec" },
        "description": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    }
  ]
}
