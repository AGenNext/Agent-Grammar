{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agennext.dev/grammar/creativework/base.schema.json",
  "title": "AGenNext CreativeWork Base Grammar",
  "type": "object",
  "required": ["@context", "@type", "name", "artifactKind"],
  "properties": {
    "@context": {
      "type": "string",
      "const": "https://schema.org"
    },
    "@type": {
      "type": "string",
      "minLength": 1
    },
    "artifactKind": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "potentialAction": {
      "oneOf": [
        { "type": "object" },
        { "type": "array" }
      ]
    }
  },
  "additionalProperties": true
}
